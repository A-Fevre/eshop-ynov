# API Gateway - utilisé par les loaders (SSR) à chaque requête / changement de page
# Obligatoire : le serveur Node (Vite) doit avoir cette variable pour appeler le gateway
# Obligatoire si le panier / appels API sont faits depuis le navigateur (useBasket, etc.)
# Vite n'expose au client que les variables préfixées par VITE_
VITE_API_BASE_URL=http://localhost:6064

# Application Configuration
NODE_ENV=development
PORT=3000
